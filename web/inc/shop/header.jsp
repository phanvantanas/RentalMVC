<%@page pageEncoding="UTF-8"%>
<header class="shop-header"><a class="brand" href="${pageContext.request.contextPath}/home"><span class="brand-icon"><svg><use href="#i-camera"/></svg></span><span>LensCam<small>RENTAL HUB</small></span></a><nav><a href="${pageContext.request.contextPath}/home">Khám phá thiết bị</a><a href="${pageContext.request.contextPath}/my-rentals">Đơn thuê của tôi</a><a class="header-cart" href="${pageContext.request.contextPath}/cart"><svg class="cart-menu-icon" aria-hidden="true"><use href="#i-cart"/></svg>Giỏ hàng <span>${empty sessionScope.rentalCart ? 0 : sessionScope.rentalCart.count}</span></a><c:choose><c:when test="${not empty sessionScope.user}"><span class="shop-user"><c:out value="${sessionScope.user.name}"/></span></c:when><c:otherwise><a href="${pageContext.request.contextPath}/login">Đăng nhập</a></c:otherwise></c:choose></nav></header>
