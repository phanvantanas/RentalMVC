<%@page pageEncoding="UTF-8"%>
<section class="receipt-upload" aria-labelledby="receipt-heading"><h3 id="receipt-heading">Tải ảnh chuyển khoản</h3><p>Gửi ảnh biên lai để LensCam đối soát đơn thuê nhanh hơn.</p><c:if test="${payment.hasReceipt}"><div class="receipt-current"><a href="${ctx}/payment/receipt?order=${payment.rental_id}" target="_blank" rel="noopener"><img src="${ctx}/payment/receipt?order=${payment.rental_id}" alt="Ảnh chuyển khoản đã gửi">Ảnh đã gửi · Xem đầy đủ ↗</a></div></c:if><form id="receipt-form" action="${ctx}/payment/receipt?order=${payment.rental_id}" method="post" enctype="multipart/form-data"><input type="hidden" name="csrf" value="${sessionScope.shopCsrf}"><label class="receipt-picker" for="receipt-file"><svg><use href="#i-camera"/></svg><strong>${payment.hasReceipt ? 'Chọn ảnh thay thế' : 'Chọn ảnh biên lai'}</strong><span>PNG hoặc JPG · Tối đa 5 MB</span><input type="file" id="receipt-file" name="receipt" accept="image/png,image/jpeg" required></label><div class="receipt-preview" id="receipt-preview" hidden><img id="receipt-preview-image" alt="Xem trước ảnh chuyển khoản"><span id="receipt-file-name"></span></div><p class="receipt-file-error" id="receipt-file-error" role="alert" hidden></p><button class="button receipt-submit" id="receipt-submit" type="submit" disabled>${payment.hasReceipt ? 'Cập nhật ảnh chuyển khoản' : 'Gửi ảnh chuyển khoản'}</button></form><p class="summary-note">Ảnh biên lai dùng để đối soát. Trạng thái đã nhận tiền được admin xác nhận sau khi kiểm tra tài khoản ngân hàng.</p></section>
