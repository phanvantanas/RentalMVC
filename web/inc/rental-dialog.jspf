<%@page pageEncoding="UTF-8"%>
<dialog id="rental-dialog" class="modal"><form method="dialog"><button class="close-dialog" aria-label="Đóng">×</button></form><span class="eyebrow">THÔNG TIN THUÊ THIẾT BỊ</span><h2 id="rental-name"></h2><p class="muted">Chi phí tham khảo cho lịch thuê đã chọn.</p><dl class="quote"><div><dt>Ngày nhận – trả</dt><dd>${dateLabel} · ${pickupTime} – ${returnTime}</dd></div><div><dt>Thời gian thuê</dt><dd>${rentalDays} ngày</dd></div><div><dt>Giá thuê / ngày</dt><dd id="quote-price"></dd></div><div><dt>Tiền thuê trước ưu đãi</dt><dd id="quote-subtotal"></dd></div><div><dt>Ưu đãi thời gian thuê</dt><dd id="quote-discount"></dd></div><div class="quote-total"><dt>Tổng tiền thuê</dt><dd id="quote-total"></dd></div><div><dt>Tiền đặt cọc</dt><dd id="quote-deposit"></dd></div></dl><p class="dialog-note">Đây là bảng tính chi phí, chưa giữ chỗ thiết bị hoặc tạo đơn thuê.</p><c:if test="${empty sessionScope.user}"><a class="button full-width" href="${ctx}/login">Đăng nhập tài khoản <svg><use href="#i-arrow"/></svg></a></c:if></dialog>
