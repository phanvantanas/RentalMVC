<%@page pageEncoding="UTF-8"%>
<article class="my-order-card" data-order-status="<c:out value='${order.status}'/>">
<header class="my-order-card-heading"><div><span class="my-order-code">#ORD-${order.id}</span><span class="my-order-created">Đặt ngày <fmt:formatDate value="${order.createdAt}" pattern="dd/MM/yyyy HH:mm"/></span></div><span class="my-status ${order.status}"><c:out value="${rentalLabels[order.status]}" default="Đang cập nhật"/></span></header>
<c:choose><c:when test="${order.status eq 'cancelled'}"><div class="my-order-cancelled">Đơn đã hủy. Vui lòng không chuyển khoản cho đơn này. Nếu đã chuyển tiền, hãy liên hệ LensCam để được hỗ trợ.</div></c:when><c:otherwise>
<ol class="my-order-progress" aria-label="Tiến trình đơn thuê"><c:forEach var="step" begin="1" end="4"><li class="${order.step ge step ? 'reached' : ''} ${order.step eq step ? 'current' : ''}" ${order.step eq step ? 'aria-current="step"' : ''}><span>${order.step gt step ? '✓' : step}</span><c:choose><c:when test="${step eq 1}">Chờ duyệt</c:when><c:when test="${step eq 2}">Chờ nhận máy</c:when><c:when test="${step eq 3}">Đang thuê</c:when><c:otherwise>Đã trả máy</c:otherwise></c:choose></li></c:forEach></ol>
</c:otherwise></c:choose>
<div class="my-order-body"><section class="my-order-equipment"><h2>Thiết bị trong đơn <span>${fn:length(order.items)}</span></h2><c:forEach var="item" items="${order.items}"><div class="my-rental-item"><span class="my-item-icon"><svg aria-hidden="true"><use href="#i-camera"/></svg></span><div><strong><c:out value="${item.name}"/></strong><c:if test="${detailOrder}"><small>Serial: <c:out value="${item.serial}" default="Đang cập nhật"/></small></c:if></div><span><fmt:formatNumber value="${item.price}" maxFractionDigits="0"/>đ<small>/ ngày</small></span></div></c:forEach><c:if test="${empty order.items}"><p class="my-rental-muted">Thiết bị đang được cập nhật. Vui lòng liên hệ LensCam để xác nhận.</p></c:if>
<div class="my-rental-schedule"><div><span>Ngày nhận máy</span><strong><fmt:formatDate value="${order.startDate}" pattern="dd/MM/yyyy"/></strong><small>${empty order.pickupTime ? 'Giờ nhận: liên hệ xác nhận' : order.pickupTime}</small></div><svg aria-hidden="true"><use href="#i-arrow"/></svg><div><span>Ngày trả máy</span><strong><fmt:formatDate value="${order.endDate}" pattern="dd/MM/yyyy"/></strong><small>${empty order.returnTime ? 'Giờ trả: liên hệ xác nhận' : order.returnTime}</small></div></div>
<c:if test="${order.overdue}"><p class="my-overdue" role="status">Đơn đã quá ngày trả máy. Vui lòng liên hệ LensCam để sắp xếp trả hoặc gia hạn.</p></c:if>
</section><aside class="my-order-payment"><span class="eyebrow">THÔNG TIN THANH TOÁN</span><span class="my-payment-status ${order.paymentStatus}"><c:out value="${order.hasPayment ? paymentLabels[order.paymentStatus] : 'Chưa có dữ liệu thanh toán'}" default="Chưa có dữ liệu thanh toán"/></span><dl><div><dt>Tiền thuê</dt><dd><fmt:formatNumber value="${order.total}" maxFractionDigits="0"/>đ</dd></div><c:if test="${order.lateFee gt 0}"><div><dt>Phí trả trễ</dt><dd><fmt:formatNumber value="${order.lateFee}" maxFractionDigits="0"/>đ</dd></div></c:if></dl>
<c:if test="${order.receiptAvailable}"><a class="my-receipt-link" href="${ctx}/payment/receipt?order=${order.id}" target="_blank" rel="noopener">✓ Xem biên lai đã gửi ↗</a></c:if>
<c:if test="${order.hasPayment}"><a class="button full-width" href="${ctx}/checkout?order=${order.id}">${order.paymentStatus eq 'paid' or order.status eq 'cancelled' ? 'Xem thanh toán' : (order.paymentStatus eq 'reported' ? 'Xem trạng thái đối soát' : 'Tiếp tục thanh toán')} <svg aria-hidden="true"><use href="#i-arrow"/></svg></a></c:if>
<c:if test="${not detailOrder}"><a class="my-rental-detail-link" href="${ctx}/my-rentals?order=${order.id}">Xem chi tiết đơn thuê →</a></c:if><c:if test="${detailOrder and not empty order.transferReference}"><p class="my-rental-reference">Nội dung chuyển khoản: <strong><c:out value="${order.transferReference}"/></strong></p></c:if>
</aside></div></article>
